        "inhalt": "<!doctype html>\n<html lang=\"de\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Sternkarte – Skizze</title>\n<style>\nbody{margin:0;background:#000;color:#99ccff;font:14px system-ui,sans-serif}\nh1{position:absolute;left:20px;top:12px;margin:0;font-size:20px;letter-spacing:.08em;text-transform:uppercase}\nsvg{display:block;width:100vw;height:100vh}\ncircle{fill:#f2e6d9}.weg{stroke:#9977cc;stroke-width:2;fill:none;stroke-dasharray:6 6}\n</style></head>\n<body><h1>Sternwarte · Sektor 7</h1>\n<svg viewBox=\"0 0 800 500\" preserveAspectRatio=\"xMidYMid slice\">\n<path class=\"weg\" d=\"M90 400 C 250 300, 380 380, 520 220 S 700 120, 740 80\"/>\n<circle cx=\"90\" cy=\"400\" r=\"9\" fill=\"#ff9c33\"/><circle cx=\"520\" cy=\"220\" r=\"7\"/><circle cx=\"740\" cy=\"80\" r=\"11\" fill=\"#8899ff\"/>\n<circle cx=\"160\" cy=\"90\" r=\"2\"/><circle cx=\"300\" cy=\"150\" r=\"3\"/><circle cx=\"420\" cy=\"60\" r=\"2\"/><circle cx=\"640\" cy=\"330\" r=\"3\"/>\n<circle cx=\"230\" cy=\"250\" r=\"2\"/><circle cx=\"700\" cy=\"450\" r=\"2\"/><circle cx=\"360\" cy=\"460\" r=\"3\"/><circle cx=\"60\" cy=\"200\" r=\"2\"/>\n</svg>\n<script>document.querySelectorAll('circle').forEach(function(c,i){c.style.opacity=.5+.5*Math.abs(Math.sin(i))})</script>\n</body></html>\n"
