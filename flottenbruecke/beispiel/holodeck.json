        "inhalt": "<!doctype html>\n<html lang=\"de\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Anmeldung (mobil)</title>\n<style>\nbody{margin:0;min-height:100vh;display:grid;place-items:center;font:16px/1.5 system-ui,sans-serif;background:#0d0d14;color:#f2e6d9}\n.box{width:min(340px,90vw);padding:28px;border-radius:24px;background:#15151f;border-left:12px solid #8899ff}\nh1{margin:0 0 16px;font-size:24px}\nlabel{display:block;margin:12px 0 4px;color:#a59a8f;font-size:13px}\ninput{width:100%;box-sizing:border-box;padding:10px 14px;border-radius:999px;border:1px solid #26263a;background:#000;color:inherit;font:inherit}\nbutton{margin-top:20px;width:100%;padding:12px;border:0;border-radius:999px;background:#ff9c33;font:600 16px system-ui}\n#hinweis{min-height:1.5em;color:#66cc99;font-size:13px}\n</style></head>\n<body><div class=\"box\"><h1>Anmelden</h1>\n<label for=\"n\">Name</label><input id=\"n\" autocomplete=\"off\" placeholder=\"Picard\">\n<label for=\"c\">Zugangscode</label><input id=\"c\" type=\"password\" placeholder=\"••••\">\n<button id=\"los\">Weiter</button><p id=\"hinweis\"></p></div>\n<script>document.getElementById('los').onclick=function(){document.getElementById('hinweis').textContent='Nur ein Entwurf: nichts wird gesendet.'}</script>\n</body></html>\n"
