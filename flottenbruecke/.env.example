# Copy to .env (never committed). The PIN and the VAPID key are secrets.

# Port on this machine; the page is http://<machine>:<port>/ in the LAN
BRUECKE_PORT=4747
# 0.0.0.0: reachable in the LAN (phone in the WLAN); 127.0.0.1: only on this machine
BRUECKE_BIND=0.0.0.0
# an: the remote entry for Tailscale exists (still off until the profile fernzugriff runs); aus: it is not served at all.
# einrichten.ps1 -Variante arbeitsrechner writes 127.0.0.1 and aus.
BRUECKE_FERNZUGRIFF=an
# Port of the machine's own entry (#46), only on 127.0.0.1: http://localhost:<port>/ gives devices their rights
BRUECKE_RECHNER_PORT=4748
# PIN for pairing a device and, with a paired device, for each answer and action. Empty: writing is switched off.
BRUECKE_PIN=
# Optional: when set, the driver sends it as X-Bruecke-Token with report, fetch and acknowledge
BRUECKE_TOKEN=
# Time zone for "Gemergt (heute)"
BRUECKE_TZ=Europe/Berlin

# Optional (#37): HTTPS in the LAN with a mkcert certificate in ./zert (mounted as /zert).
# Both empty: plain HTTP as before. The phone's Web-Push needs HTTPS.
BRUECKE_ZERT=
BRUECKE_ZERT_SCHLUESSEL=
# Optional (#37): Web-Push to the installed web app. Empty: off, no push service is ever contacted.
# Create one with: docker compose run --rm bruecke python -m app.meldung
BRUECKE_VAPID_SCHLUESSEL=
# Contact the push service sees (sub claim); empty: mailto:flottenbruecke@localhost
BRUECKE_VAPID_KONTAKT=

# Optional (#48, ADR-0006): remote access over Tailscale, view only. Off unless started with
# docker compose --profile fernzugriff up -d (README.md, "Fernzugriff"). Uncomment and fill in to use it.
# Auth key from the Tailscale admin console (Settings, Keys); a secret like the PIN.
# BRUECKE_TS_SCHLUESSEL=
# Name of the bridge in the tailnet: https://<name>.<tailnet>.ts.net/
# BRUECKE_TS_NAME=flottenbruecke
